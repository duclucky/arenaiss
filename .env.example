# Server-side values. Copy to an ignored .env and fill locally.
ARENA_OPERATOR_ADDRESS=
ARENA_DATABASE_PATH=.local/arena-runtime.sqlite
PORT=8787
HOST=127.0.0.1
ARENA_RATE_LIMIT_MAX=60
ARENA_RATE_LIMIT_WINDOW_MS=60000

# Rootless Docker deployment. runtime.env contains server-only values and is ignored.
ARENA_BIND_ADDRESS=0.0.0.0
ARENA_HTTP_PORT=8080

# Public frontend runtime configuration.
VITE_ARC_CHAIN_ID=5042002
VITE_ARC_NETWORK_NAME=Arc Testnet
VITE_ARC_RPC_URL=
VITE_ARC_USDC_ADDRESS=
VITE_ARC_ESCROW_ADDRESS=
VITE_ARENA_API_URL=/
VITE_GENLAYER_EXPLORER_URL=https://explorer-studio.genlayer.com
