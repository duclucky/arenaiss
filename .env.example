# Server-side values. Copy to an ignored .env and fill locally.
ARENA_OPERATOR_ADDRESS=
ARENA_DATABASE_PATH=.local/arena-runtime.sqlite
PORT=8787
HOST=127.0.0.1
ARENA_RATE_LIMIT_MAX=60
ARENA_RATE_LIMIT_WINDOW_MS=60000

# Managed Circle wallets + email OTP. All values are required together.
# Generate/register CIRCLE_ENTITY_SECRET yourself and store its recovery file
# outside this repository. Never commit any value below.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
ARC_AGENT_REGISTRY_ADDRESS=
ARENA_IDENTITY_PEPPER=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Shared Tournament/Evo/Pair provider configuration. The existing FALLBACK_*
# credentials now select OpenAI as primary. API_KEY/END_POINT/MODEL select
# Cheap as fallback after a transient OpenAI failure.
API_KEY=
END_POINT=
# OpenAI primary credentials. Both routes must be configured for execution.
# The OpenAI endpoint defaults to https://api.openai.com/v1 when left empty.
FALLBACK_END_POINT=
FALLBACK_API_KEY=
FALLBACK_MODEL=
MODEL=

# Evo execution. The fee is Arc USDC (maximum 6 decimals). Studio Next gas is
# paid by the existing owner key; GENLAYER_OWNER_PRIVATE_KEY is an optional
# clearer alias for the legacy STUDIONET_PRIVATE_KEY variable.
EVALUATION_FEE_USDC=1
GENLAYER_EVALUATION_JUDGE_ADDRESS=0x0aA2B27D04BAa4438f2c3B9560eb7989de5a934d
STUDIONET_PRIVATE_KEY=
GENLAYER_OWNER_PRIVATE_KEY=

# Rootless Docker deployment. runtime.env contains server-only values and is ignored.
ARENA_BIND_ADDRESS=0.0.0.0
ARENA_HTTP_PORT=8080

# Public frontend runtime configuration.
VITE_ARC_CHAIN_ID=5042002
VITE_ARC_NETWORK_NAME=Arc Testnet
VITE_ARC_RPC_URL=
VITE_ARC_USDC_ADDRESS=
VITE_ARC_ESCROW_ADDRESS=
VITE_ARENA_API_URL=/
VITE_GENLAYER_CHAIN_ID=61997
VITE_GENLAYER_NETWORK_NAME=GenLayer Studio Next
VITE_GENLAYER_RPC_URL=https://studio-next.genlayer.com/api
VITE_GENLAYER_EXPLORER_URL=https://explorer-studio-dev.genlayer.com
VITE_GENLAYER_EVALUATION_JUDGE_ADDRESS=0x0aA2B27D04BAa4438f2c3B9560eb7989de5a934d
VITE_GENLAYER_COMPARISON_JUDGE_ADDRESS=0xe5210eCCC4182090A1416f515Dc7001B27274BcB
