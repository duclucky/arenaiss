:8080 {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://db.onlinewebfonts.com; font-src 'self' https://db.onlinewebfonts.com; script-src 'self'; connect-src 'self' https://rpc.testnet.arc.network https://studio-next.genlayer.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	handle /api/* {
		reverse_proxy api:8787
	}

	handle /healthz {
		reverse_proxy api:8787
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
